<UserControl x:Class="WpfAppLab7.ProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfAppLab7"
             mc:Ignorable="d" 
             DataContextChanged="UserControl_DataContextChanged"
             d:DesignHeight="200" d:DesignWidth="800" FontFamily="Calibri" Height="200" >
    <UserControl.Resources>
        <local:ImageSourceConverter x:Key="ImgConverter"/>
    </UserControl.Resources>
    
    <Border BorderThickness="2" BorderBrush="Black" x:Name="controlBorder" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderThickness="2" BorderBrush="Black" Margin="5" >
                <Image Source="{Binding Image, Converter={StaticResource ImgConverter}}" Stretch="Uniform"/>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5,5,1,5" >
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FkCategory.CategoryName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="|" FontWeight="Bold" />
                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description, StringFormat='{}Описание: {0}'}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FkManufacturer.ManufacturerName, StringFormat='{}Производитель: {0}'}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FkSupplier.SupplierName, StringFormat='{}Поставщик: {0}'}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Цена: "/>
                        <TextBlock x:Name="OldPrice" TextDecorations="Strikethrough" Foreground="Red"/>
                        <TextBlock x:Name="NewPrice" Text="{Binding Price}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Measurement, StringFormat='{}Единица измерения: {0}'}"/>
                    <TextBlock Text="{Binding Quantity, StringFormat='{}Количество на складе: {0}'}"/>
                </StackPanel>
            </Border>

            <Border BorderThickness="2" BorderBrush="Black" Margin="0,5,5,5" Grid.Column="2" >
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Действующая скидка"/>
                    <TextBlock Text="{Binding Discount, StringFormat='{}{0}%'}" FontSize="24" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
