<UserControl x:Class="Lab1.ProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lab1"
             xmlns:models="clr-namespace:Lab1.Models"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800"
             FontFamily="Times New Roman" FontSize="11pt"
             DataContextChanged="UserControl_DataContextChanged">

    <d:UserControl.DataContext>
        <models:Product Count="123" CurrentDiscount="123" Name="name" Price="100"/>
    </d:UserControl.DataContext>
    
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="2">
                <TextBlock Text="Photo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Column="1" Margin="5" BorderBrush="Black" BorderThickness="1">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Category.Name}"/>
                        <TextBlock Text=" | "/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock x:Name="DescText" Text="{Binding Description, StringFormat='{}Decription: {0}'}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ManuText" Text="{Binding Manufacturer.Name, StringFormat='{}Manufacturer: {0}'}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ProvText" Text="{Binding Provider.Name, StringFormat='{}Provider: {0}'}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PriceText" Text="{Binding Price, StringFormat='{}Price: {0}'}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="UnitText" Text="{Binding Unit, StringFormat='{}Unit: {0}'}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="InStockText" Text="{Binding Count, StringFormat='{}In Stock: {0}'}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="5" BorderBrush="Black" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Current Discount:"/>
                    <TextBlock Text="{Binding CurrentDiscount, StringFormat='{}{0}%'}" TextAlignment="Center" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
