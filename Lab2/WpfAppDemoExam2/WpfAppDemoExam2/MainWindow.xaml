<Window x:Class="WpfAppDemoExam2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppDemoExam2"
        mc:Ignorable="d"
        Title="Log In" Height="400" Width="400" FontFamily="Times New Roman" FontSize="13">
    <StackPanel Width="300" Height="250" >
        <Label Content="Login" Margin="5"/>
        <TextBox x:Name="loginBox" Margin="5"/>
        <Label Content="Password" Margin="5"/>
        <PasswordBox x:Name="passwordBox" Margin="5"/>

        <Button x:Name="signInButton" Content="Sign In" Margin="5" Background="Azure" Click="signInButton_Click"/>
        <Button x:Name="signInAsGuestButton" Content="As Guest" Width="100" HorizontalAlignment="Right" Margin="5" Background="Bisque" Click="signInAsGuestButton_Click"/>
    </StackPanel>
</Window>
