<UserControl x:Class="WpfAppDemoExam2.BookControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfAppDemoExam2"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <d:UserControl.DataContext>
        <local:Book BookTitle="lalala"/>
    </d:UserControl.DataContext>
    <Grid>
        <TextBlock x:Name="TitleText" Text="{Binding BookTitle, StringFormat='{}Title: {0}'}" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
