<Window x:Class="WpfAppLab5.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppLab5"
        mc:Ignorable="d"
        Title="Товары" Height="450" Width="800" MinHeight="200" MinWidth="450" FontFamily="Arial" FontSize="13" WindowStartupLocation="CenterScreen"
        Icon="/Resources/icon.ico">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
            <TextBlock x:Name="nameBox" DockPanel.Dock="Left" Text="Гость" VerticalAlignment="Center" Margin="10,5"/>

            <Button x:Name="addProductButton" Content="Добавить товар" Padding="5,2" DockPanel.Dock="Right"  Visibility="Collapsed" Click="addProductButton_Click"/>

            <Button x:Name="signOutButton" Content="Выход" DockPanel.Dock="Left" Margin="5,0" Padding="5,2" Click="signOutButton_Click"/>

            <Label/>
        </DockPanel>

        <DockPanel x:Name="SearchFilterDock" DockPanel.Dock="Top" Visibility="Collapsed" Margin="5">
            <TextBlock Text="Поиск:" DockPanel.Dock="Left" VerticalAlignment="Center" />


            <ComboBox x:Name="discountComboBox" DockPanel.Dock="Right" SelectionChanged="discountComboBox_SelectionChanged">
                <ComboBoxItem Content="Все товары" Tag="All" IsSelected="True"/>
                <ComboBoxItem Content="0 - 11.99%" Tag="Low"/>
                <ComboBoxItem Content="12 - 18.99%" Tag="Medium"/>
                <ComboBoxItem Content="19% и более" Tag="High"/>
            </ComboBox>

            <TextBlock Text="Скидка: " VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,5,0"/>

            <ComboBox x:Name="sortComboBox" DockPanel.Dock="Right" SelectionChanged="sortComboBox_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Наименование (А-Я)"/>
                <ComboBoxItem Content="Наименование (Я-А)"/>
                <ComboBoxItem Content="Цена (по возрастанию)"/>
                <ComboBoxItem Content="Цена (по убыванию)"/>
            </ComboBox>
            <TextBlock Text="Сортировка:  " DockPanel.Dock="Right" VerticalAlignment="Center" />
            <TextBox x:Name="searchBox" Margin="10,0" TextChanged="searchBox_TextChanged" />
        </DockPanel>

 
        <ScrollViewer>
            <ItemsControl x:Name="itemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="ProductButton" Background="Transparent" BorderBrush="Transparent" Padding="0" Click="ProductButton_Click">
                            <local:ProductControl/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
