<UserControl x:Class="WpfAppLab5.ProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfAppLab5"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800"
             DataContextChanged="UserControl_DataContextChanged"
             FontFamily="Arial">

    <UserControl.Resources>
        <local:ImageSourceConverter x:Key="ImgConverter"/>
    </UserControl.Resources>
    <Grid x:Name="ProductGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Image Not Found" VerticalAlignment="Center" HorizontalAlignment="Center" />

        <Border BorderThickness="1" BorderBrush="Black" Margin="5">
            <Image Source="{Binding ImagePath, Converter={StaticResource ImgConverter}}" 
               Stretch="Uniform"/>
        </Border>


        <Border BorderThickness="1" BorderBrush="Black" Margin="5" Grid.Column="1">
            <StackPanel Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding FkCategory.CategoryName}"/>
                    <TextBlock Text=" | "/>
                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock x:Name="DescText" Text="{Binding Description, StringFormat='{}Описания: {0}'}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ManuText" Text="{Binding FkManufacturer.ManufacturerName, StringFormat='{}Производитель: {0}'}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ProvText" Text="{Binding FkSupplier.SupplierName, StringFormat='{}Поставщик: {0}'}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="OldPriceText" Text="" TextTrimming="CharacterEllipsis" TextDecorations="Strikethrough" Foreground="Red"/>
                    <TextBlock x:Name="NewPriceText" Text="{Binding Price,StringFormat='{}Цена: {0}'}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="UnitText" Text="{Binding UnitName, StringFormat='{}Измерение: {0}'}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InStockText" Text="{Binding Quantity, StringFormat='{}In Stock: {0}'}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Margin="5" BorderBrush="Black" BorderThickness="1">
            <StackPanel Grid.Column="0" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Действующая скидка: " FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DiscountText" Text="{Binding Discount,StringFormat='{}{0}%'}" FontSize="28" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>


    </Grid>
</UserControl>
