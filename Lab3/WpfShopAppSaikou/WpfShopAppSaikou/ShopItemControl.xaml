<UserControl x:Class="WpfShopAppSaikou.ShopItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfShopAppSaikou"
             mc:Ignorable="d" 
             FontFamily="Times New Roman" FontSize="11pt"
             d:DesignHeight="200" d:DesignWidth="700"
             DataContextChanged="UserControl_DataContextChanged">

    <Grid x:Name="ProductGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="*" MinWidth="100px"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="1">
            <StackPanel Grid.Column="0" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Category.Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text=" | " FontWeight="Bold" />
                    <TextBlock Text="{Binding Article}" FontWeight="Bold"  TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Text="{Binding Name.Name,StringFormat='{}Наименование: {0}'}"/>
                <TextBlock Text="{Binding Description,StringFormat='{}Описание: {0}'}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Manufacturer.Name,StringFormat='{}Производитель: {0}'}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Supplier.Name,StringFormat='{}Поставщик: {0}'}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="OldPriceText" Text="" TextTrimming="CharacterEllipsis" TextDecorations="Strikethrough" Foreground="Red"/>
                    <TextBlock x:Name="NewPriceText" Text="{Binding Price,StringFormat='{}Цена: {0}'}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Text="{Binding Manufacturer.Name,StringFormat='{}Производитель: {0}'}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Count,StringFormat='{}Количество на складе: {0}'}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="editButton" Content="Изменить" Margin="5,0" Padding="10,2" Click="editButton_Click"/>
                    <Button x:Name="deleteButton" Content="Удалить" Margin="5,0" Padding="10,2" Click="deleteButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="5" BorderBrush="Black" BorderThickness="1">
            <StackPanel Grid.Column="0" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Действующая скидка: " FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DiscountText" Text="{Binding Discount,StringFormat='{}{0}%'}" FontSize="28" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
